# ── ECOGL Environment ──────────────────────────────────────────
APP_NAME=ECOGL
APP_ENV=development  # development | staging | production
DEMO_MODE=false

# Database
DATABASE_URL=sqlite:///./ecogl.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ecogl

# Auth / RBAC
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Earth Engine — NEVER commit real values
GEE_PROJECT_ID=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-service-account@your-gee-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative: path to JSON key file
GEE_KEY_FILE=/secrets/gee-key.json

# Scheduler
SCHEDULER_ENABLED=true
FOREST_MONITORING_CRON=0 2 * * *   # every day 02:00
# or interval: FOREST_MONITORING_INTERVAL_HOURS=24

# Earth Engine Dataset defaults
DEFAULT_SATELLITE_SOURCE=SENTINEL2  # SENTINEL2 | LANDSAT8 | LANDSAT9

# NASA FIRMS — get MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=your-firms-map-key
NASA_FIRMS_MAP_KEY=your-firms-map-key

# Sentinel Hub — https://services.sentinel-hub.com/ (OAuth2 client_credentials)
SENTINELHUB_CLIENT_ID=your-sentinelhub-client-id
SENTINELHUB_CLIENT_SECRET=your-sentinelhub-client-secret
SENTINELHUB_TOKEN_URL=https://services.sentinel-hub.com/oauth/token

# Copernicus Data Space — https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=your-copernicus-client-id
COPERNICUS_CLIENT_SECRET=your-copernicus-client-secret
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# CDSE alias
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# LLM AI Agent — Gemini / Groq PCCC
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
